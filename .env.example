# ── Site ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.denisawa.co.ke

# ── Supabase — health check sessions, reports, admin ────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key — used to read/write health check data and send deliveries (never exposed to the client)
SUPABASE_SERVICE_ROLE_KEY=

# ── AI (report generation) ───────────────────────────────────────────────────
# The active AI provider/model is DB-managed (admin > Settings > AI Provider),
# stored encrypted in the `app_settings` table — no redeploy needed to change.
#
# DB-managed keys (via /admin/settings):
#   AI_PROVIDER_TYPE      anthropic | google | openai
#   AI_BASE_URL           OpenAI-compatible base URL (DeepSeek/Qwen/Kimi/etc.)
#   AI_API_KEY            API key (encrypted)
#   AI_MODEL              model id
#   AI_FALLBACK_*         optional secondary provider (auto-switch on failure)
#
# The env values below are only FALLBACKS when no DB value is set.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.5-flash

# ── SMTP (dual-domain routing) ──────────────────────────────────────────────
# Emails are routed to whichever profile owns the From-address domain (matched
# against EMAIL_SENDER_DOMAINS). Unknown domains fall back to the primary.
#
# Primary profile (EMAIL_*). For Gmail use port 587 + EMAIL_SECURE=false
# (STARTTLS) with an app password; port 465 is implicit TLS (secure=true).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_SENDER_DOMAINS=gmail.com
SMTP_FROM_NAME=Deni Sawa Partners
SMTP_FROM_EMAIL=noreply@denisawa.co.ke
# Dedicated from-addresses for report/contact/investor emails
SMTP_FROM_EMAIL_REPORTS=reports@denisawa.co.ke
SMTP_FROM_EMAIL_CONTACT=hello@denisawa.co.ke
SMTP_FROM_EMAIL_INVESTORS=investors@denisawa.co.ke

# Secondary profile (EMAIL2_*). Sends From-addresses on the listed domains.
# EMAIL2_SENDER_DOMAINS should include every domain that profile may send from.
EMAIL2_HOST=mail.denisawa.co.ke
EMAIL2_PORT=465
EMAIL2_SECURE=true
EMAIL2_USER=admissions@denisawa.co.ke
EMAIL2_PASS=
EMAIL2_SENDER_DOMAINS=denisawa.co.ke,denisawa.co.ke

# Legacy aliases (fallback if EMAIL_* is not set)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# ── WhatsApp (Business API) ─────────────────────────────────────────────────
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+254700000000
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=

# Encryption key for WhatsApp credentials stored in whatsapp_config (AES-256-GCM)
CREDENTIALS_ENCRYPTION_KEY=

# Optional shared secret for the internal delivery endpoints
# INTERNAL_API_SECRET=

# ── Analytics ───────────────────────────────────────────────────────────────
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXX

# ── Storage (deni_sawa bucket) ──────────────────────────────────────────────
# Total quota shown in the admin storage page (MB) — default 1024 (1 GB).
# SUPABASE_STORAGE_QUOTA_MB=1024
# Max single-file upload (MB) — bounded by Supabase's direct-upload limit.
# SUPABASE_STORAGE_MAX_FILE_MB=50

# ── AI chat (legacy) — powers the AI chat widget via /api/chat ──────────────
GEMINI_API_KEY=
# Optional: default is gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# WhatsApp (legacy / contact page)
# NEXT_PUBLIC_WHATSAPP_NUMBER=+254712345678
