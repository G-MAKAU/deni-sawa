# ── Site ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://denisawa.co.ke

# ── Supabase — health check sessions, reports, admin ────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key — used to read/write health check data and send deliveries (never exposed to the client)
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic Claude — powers the Health Check report generation ────────────
ANTHROPIC_API_KEY=
# Optional: default is claude-sonnet-4-6
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Domain SMTP (no third-party email service) ──────────────────────────────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
SMTP_FROM_NAME=Deni Sawa Partners
SMTP_FROM_EMAIL=noreply@denisawa.co.ke
# Dedicated from-addresses for report/contact/investor emails
SMTP_FROM_EMAIL_REPORTS=reports@denisawa.co.ke
SMTP_FROM_EMAIL_CONTACT=hello@denisawa.co.ke
SMTP_FROM_EMAIL_INVESTORS=investors@denisawa.co.ke
# Legacy aliases (fallback if EMAIL_* is not set)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# ── WhatsApp (Business API) ─────────────────────────────────────────────────
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+254700000000
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=

# Encryption key for WhatsApp credentials stored in whatsapp_config (AES-256-GCM)
CREDENTIALS_ENCRYPTION_KEY=

# Optional shared secret for the internal delivery endpoints
# INTERNAL_API_SECRET=

# ── Analytics ───────────────────────────────────────────────────────────────
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXX

# ── Storage (deni_sawa bucket) ──────────────────────────────────────────────
# Total quota shown in the admin storage page (MB) — default 1024 (1 GB).
# SUPABASE_STORAGE_QUOTA_MB=1024
# Max single-file upload (MB) — bounded by Supabase's direct-upload limit.
# SUPABASE_STORAGE_MAX_FILE_MB=50

# ── AI chat (legacy) — powers the AI chat widget via /api/chat ──────────────
GEMINI_API_KEY=
# Optional: default is gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# WhatsApp (legacy / contact page)
# NEXT_PUBLIC_WHATSAPP_NUMBER=+254712345678
